{
  "name": "kleihaus-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/seo-engine.mjs",
    "seo:audit": "node scripts/seo-engine.mjs --audit-only",
    "seo:verify-production": "node scripts/verify-production-seo.mjs",
    "seo:verify-production:all": "node scripts/verify-production-seo.mjs --all-routes",
    "analytics:verify": "node scripts/verify-analytics-events.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:route-html": "node scripts/generate-route-html.mjs",
    "build": "npm run seo:generate && vite build && npm run generate:route-html && npm run seo:audit",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.44",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.8"
  }
}
